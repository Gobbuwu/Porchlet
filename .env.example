# Porchlet environment variables. Copy to .env.local for local work; never commit real values.
# On Vercel, the Supabase integration sets these for you.

# Public: sent to the browser. Row Level Security protects the data (ADR 0004).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret: server only, used by the setup wizard and invite email (ADR 0005, ADR 0024).
# Never prefix it with NEXT_PUBLIC_. scripts/e2e/write-env.sh sets the local stack's.
SUPABASE_SECRET_KEY=

# Server only: this site's own origin, for invite links (ADR 0024). Never taken from the request.
# Must be on the same host as Supabase Auth's site URL, or invite emails lose their link.
SITE_URL=http://127.0.0.1:3000

# Secret: server only. Lets the server count auth attempts per visitor IP in Postgres (ADR 0015).
# It can touch only the rate-limit counters. The database stores its SHA-256 in
# private.rate_limit_key; scripts/e2e/write-env.sh sets both locally. Generate: openssl rand -hex 32
RATE_LIMIT_KEY=

# Optional, server only. New passwords are checked against Have I Been Pwned's Pwned Passwords API
# (ADR 0019); only 5 hex characters of the password's SHA-1 are sent. Set to "off" on a host with
# no outbound internet. The bundled common-password list is always checked.
# BREACHED_PASSWORD_CHECK=off

# Optional, server only. How many hosts in front of the app append their own entry to
# X-Forwarded-For; the visitor's IP is the entry that many places from the end (ADR 0029). Leave it
# unset on Vercel (1) and Netlify (2, detected from Netlify's SITE_ID). Set it only for your own
# chain of reverse proxies, for example 2 for a CDN in front of nginx. Too low: every visitor shares
# the rate limits. Too high: a visitor can choose their own.
# TRUSTED_PROXY_HOPS=
